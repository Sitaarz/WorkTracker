# =====================================================================
# WorkTracker - example environment variables
#
# Copy this file to `.env` and adjust the values for your environment:
#     cp .env.example .env
#
# The `.env` file is picked up automatically by Docker Compose when you
# run `docker compose up` from the repository root.
#
# NOTE: docker-compose.yml currently hardcodes these values. If you want
# Compose to actually read them from `.env`, replace the literal values
# in docker-compose.yml with `${VAR_NAME}` references (e.g.
# `POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}`).
# =====================================================================


# ---------------------------------------------------------------------
# PostgreSQL (service: db)
# ---------------------------------------------------------------------
# Credentials and database name used to initialize the Postgres container.
# Must match the values in ConnectionStrings__DefaultConnection below.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=worktracker


# ---------------------------------------------------------------------
# Backend API (service: api / migrate)
# ---------------------------------------------------------------------
# .NET environment. Use `Development` to enable Swagger UI at /swagger
# and to relax the `Secure` flag on the auth cookie for local HTTP.
# Use `Production` for any deployed environment.
ASPNETCORE_ENVIRONMENT=Development

# EF Core / Npgsql connection string.
# Inside Docker Compose the host is the service name `db`.
# For local runs (outside Docker) use `Host=localhost`.
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=worktracker;Username=postgres;Password=postgres

# JWT settings consumed by WorkTracker.Infrastructure/Authentication/JwtOptions.cs
Jwt__Issuer=WorkTracker
Jwt__Audience=WorkTracker.Users
# HMAC signing key - MUST be at least 32 characters and MUST be replaced
# with a strong random secret in any non-local environment.
Jwt__SecretKey=dev-secret-change-me-1234567890123123
# Access token lifetime in minutes.
Jwt__ExpirationMinutes=60

# Allowed CORS origins for the SPA. Only needed when the frontend is
# served from a different origin than the API (e.g. `ng serve` on :4200).
# When the SPA is served by Nginx through the same origin (Docker Compose
# setup), this can be left empty.
Cors__AllowedOrigins__0=http://localhost:4200


# ---------------------------------------------------------------------
# Frontend (service: web)
# ---------------------------------------------------------------------
# The Angular app reads its API base URL from
# `frontend/src/environments/environment*.ts` at build time, not from
# runtime environment variables. In the Docker Compose setup Nginx
# reverse-proxies `/api/` to the `api` service, so no variables are
# needed here. Change the environment files if you need a different
# base URL for a custom build.
